# AlgoTrade — Environment Variables
# ===================================
# Copy this file to .env and fill in your values.
# .env is in .gitignore — it will never be committed.

# ── JWT signing secret ──────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY= 

# ── MultiTrade feed path (optional override) ────────────────
# Default: C:\AlgoTrading\data\multitrade_feed.xls
# MULTITRADE_XLS=C:\AlgoTrading\data\multitrade_feed.xls

# ── Database (production only — not needed for local dev) ───
# DATABASE_URL=postgresql://algotrade:password@localhost:5432/algotrade

# ── Redis (production only — not needed for local dev) ──────
# REDIS_URL=redis://localhost:6379

# ── Delta Exchange India (Gold trading only — no crypto) ─────────────────────
# Get from: https://india.delta.exchange → Profile → API Keys → Create Key
# Permissions needed: Read + Trade
DELTA_API_KEY=uw7RSJEf7nGeMcipnsZmlckW1s1BqF
DELTA_API_SECRET=eUJvlWAJ9UYjswZBt4lK8HkAvSUXeRYg8NNo47EDYIbAiZP7QDHPbx23t16F

# ── Razorpay Payment Gateway ──────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Test keys start with rzp_test_, live keys with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Telegram Signal Bot ───────────────────────────────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → copy the token
# Step 2: Add the bot to your channel/group as admin
# Step 3: Get your chat ID from @userinfobot (channels use -100xxxxxxxxx)
# Step 4: Test at http://localhost:8000/telegram/test after filling these
TELEGRAM_BOT_TOKEN=AAG4F170ORIvrlmIXK96tbAAcIFKiAk99UQ
TELEGRAM_CHAT_ID=8996959555
TELEGRAM_MIN_SCORE=75
